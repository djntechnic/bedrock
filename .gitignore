# ==============================================================================
# 1. PYTHON, TESTING & CACHE
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/

# Pytest / Coverage
.pytest_cache/
.coverage
htmlcov/

# pytest-testmon local cache (delta-based test selection; per-dev/per-session)
.testmondata
.testmondata-journal
.testmondata-shm
.testmondata-wal

# ==============================================================================
# 2. ENVIRONMENT, CONFIG & DEPENDENCIES
# ==============================================================================
.env
.env.local
.dependencies_installed
node_modules/
.venv/

# ==============================================================================
# 3. BUILD, PACKAGING & DISTRIBUTION
# ==============================================================================
build/
/dist/
!packages/bedrock-ui/dist/
*.zip

# ==============================================================================
# 4. DATABASES & DATA STORAGE
# ==============================================================================
*.db
*.sqlite
*.sqlite3

# SQLite sidecars (WAL / shared-memory / rollback journal)
*.db-wal
*.db-shm
*.db-journal

# Data directories (with explicit inclusions)
data/
!data/rankings.json
imports/

# ==============================================================================
# 5. IDE, WORKSPACE & OS
# ==============================================================================
.vscode/
.antigravity/
.antigravityrc
*.code-workspace
*_FileTree.*

# ==============================================================================
# 6. AI AGENTS & TOOLING HOOKS
# ==============================================================================
.playwright-mcp/
.superpowers/

# Agent hook state (prevents stop-hook tree dirtying)
.claude/state/

# Isolated worktrees created by the agent harness (EnterWorktree)
.claude/worktrees/

# ==============================================================================
# 7. DOCUMENTATION, DESIGN & MEDIA ASSETS
# ==============================================================================
# Stitch design renders (track .html sources only)
.stitch/designs/*.png
.stitch/designs/*/*.png

# Design reference imagery (large binaries; the docs that cite them are tracked)
docs/project/*/reference/

# Working/Scratch documents
docs/project/*/punchlists/

# Pre-eviction leftovers. These folders no longer exist in the repo — §S8 retires
# docs out of the tree entirely — but untracked files still sit under these paths
# in working copies that predate the eviction. The rules stay until those are
# cleared by hand, so that a `git add -A` cannot silently re-track them.
docs/archive/
docs/artifacts/
docs/screenshots/
docs/working files/

# Application static media assets
api/static/headshots/

# ==============================================================================
# 8. LOCAL SCRATCH, AUDITS & DEBUG
# ==============================================================================
scratch/
debug_tab*.png

# Project module exclusions
/Core
/Cloud
