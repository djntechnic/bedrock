{
  "name": "@djntechnic/bedrock-ui",
  "version": "0.6.1",
  "description": "Reusable React application platform: config-driven grid engine, admin Grid Editor, auth shell, design tokens",
  "type": "module",
  "license": "UNLICENSED",
  "exports": {
    ".": {
      "types": "./packages/bedrock-ui/dist/index.d.ts",
      "import": "./packages/bedrock-ui/dist/index.js"
    },
    "./styles/tokens.css": "./packages/bedrock-ui/src/styles/tokens.css",
    "./*": {
      "types": "./packages/bedrock-ui/dist/*.d.ts",
      "import": "./packages/bedrock-ui/dist/*.js"
    }
  },
  "files": [
    "packages/bedrock-ui/dist",
    "packages/bedrock-ui/src"
  ],
  "scripts": {
    "build": "vite build -c packages/bedrock-ui/vite.config.ts",
    "build:types": "tsc -p packages/bedrock-ui/tsconfig.json --emitDeclarationOnly --declaration --outDir packages/bedrock-ui/dist",
    "prepare": "npm run build && npm run build:types",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p packages/bedrock-ui/tsconfig.json"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  },
  "peerDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.5",
    "axios": "^1.17.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.378.0",
    "pino": "^9.2.0",
    "radix-ui": "^1.4.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^6.30.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zustand": "^4.5.7"
  }
}
