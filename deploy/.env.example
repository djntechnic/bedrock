# bedrock environment contract.
#
# Copy to `.env` at your application root. bedrock loads it with override=True,
# so this file wins over an inherited environment — which is what makes a
# checkout's .env authoritative in development, and what means you must NOT
# ship one inside a production image.
#
# Exactly one variable has no safe default: JWT_SECRET. Everything else below
# is optional and shown at its default.

# ── Required in production ───────────────────────────────────────────────────

# Signs every session JWT. Unset, bedrock generates one and persists it to
# app_config_settings so restarts do not log everyone out — a development
# convenience that is wrong in production two ways: the secret lives in the
# database it protects, and two containers generate two different secrets, so
# a token minted by one is rejected by the other.
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# ── Database ─────────────────────────────────────────────────────────────────

# SQLite at $BEDROCK_DATA_DIR/app.db, and leave it that way: SQLite is the
# engine bedrock supports today. Setting DATABASE_URL to a postgresql:// URL
# does connect, and then fails — the baseline schema and seed are SQLite
# dialect (AUTOINCREMENT, datetime('now')), and three boot-time checks issue
# PRAGMA / sqlite_master queries unconditionally. There is real Postgres
# plumbing in the connection layer, which is why this looks more finished than
# it is; it is not a supported deployment. Issue #25 tracks either completing
# it or removing it.
#
# What that costs you: SQLite takes one writer at a time, so concurrent writes
# queue and eventually surface as "database is locked". That is a real ceiling
# on a write-heavy multi-container deployment, and it is the reason to care
# about #25 rather than a reason to point DATABASE_URL somewhere hopeful.
#
# Note for anyone reading the query layer and inferring otherwise: parameters
# are written `%s` everywhere and rewritten for SQLite by DatabaseManager.
# That convention is correct and stays — it is not evidence of a working
# Postgres path.

# The compose stack's `db` service is behind the `postgres` profile and does
# not start by default. These are the values it would be created with; unset
# and unused unless you opt into a profile that does not work yet.
POSTGRES_USER=bedrock
POSTGRES_PASSWORD=
POSTGRES_DB=bedrock

# ── Paths ────────────────────────────────────────────────────────────────────

# Where bedrock resolves .env, data/ and migrations/ from. Defaults to the
# working directory; the container image sets it explicitly so the process can
# be started from anywhere.
# BEDROCK_APP_ROOT=/app

# BEDROCK_DATA_DIR=data
# SQLITE_DB_PATH=data/app.db          # relative → resolved against APP_ROOT
# BEDROCK_MIGRATIONS_DIR=migrations

# Lets a brand-new application boot before it has any data. Leave unset in
# production: an empty canonical table there means a wiped database, and the
# refusal to start is the alarm.
# BEDROCK_ALLOW_EMPTY_DB=true

# ── Application ──────────────────────────────────────────────────────────────

PORT=8000
# Verbose logging and unmasked errors. Never true in production.
DEBUG=false
# Host port the compose stack publishes the SPA on.
WEB_PORT=8080

# ── Mail (F1) ────────────────────────────────────────────────────────────────
#
# Connection settings only. Which provider is active, the From address and the
# From name are app_config_settings rows — an operator changes those in the
# admin UI without a deploy. These are here because SMTP_PASSWORD is a
# credential, and app config is rendered in that same UI and returned by the
# config export endpoint.
#
# Unset SMTP_HOST → the mail provider falls back to a logged no-op. Invitations
# and password resets are then silently undeliverable, which is survivable in
# development and is not a production configuration.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Implicit TLS from the first byte (port 465). Mutually exclusive with STARTTLS.
SMTP_USE_SSL=false
# Upgrade after greeting. On by default — an unencrypted submission carrying a
# password-reset link is not a default worth shipping.
SMTP_USE_STARTTLS=true
SMTP_TIMEOUT=10

# ── Media storage (optional) ─────────────────────────────────────────────────
# The Cloudflare Images adapter degrades to disabled when unset.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGES_HASH=

# ── S3-compatible object storage (optional) ──────────────────────────────────
#
# One adapter covers Cloudflare R2, MinIO and S3 itself; they differ only in the
# endpoint URL, which is empty for AWS. Requires `pip install 'bedrock-api[s3]'`.
# Selecting the `s3` provider without configuring it raises, and the provider
# registry falls back to local disk with a loud log — working uploads on the
# container's disk, rather than lost files.
#
# Credentials live here and never in `app_config_settings`: app config is
# rendered in an admin UI and returned by the config export endpoint.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Empty for AWS S3; the account endpoint for R2, the server for MinIO.
S3_ENDPOINT_URL=
S3_REGION=auto
# The public CDN hostname, not the API endpoint. What `verify_public` HEADs —
# and what catches Bot Fight Mode or hotlink protection sitting in front of a
# perfectly healthy bucket.
S3_PUBLIC_BASE_URL=

# ── Frontend ─────────────────────────────────────────────────────────────────
#
# Baked into the bundle at build time by Vite — setting it on a running
# container does nothing. Empty means same-origin, which is what the compose
# stack uses: nginx proxies /api to the API container, so there is one origin
# and no CORS to configure.
# VITE_API_BASE_URL=
