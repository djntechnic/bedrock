# bedrock SPA image: build the Vite bundle, serve it from nginx.
#
# Like Dockerfile.api this is a template that lives in the application's
# repository. It assumes a `frontend/` directory with the usual Vite layout.
#
# Build:  docker build -f deploy/Dockerfile.web -t myapp-web .

# ── Stage 1: build ───────────────────────────────────────────────────────────
FROM node:20-slim AS builder

WORKDIR /build

# `git` because the bedrock packages are pinned as git dependencies rather than
# published to a registry (see the repo README on why). npm shells out to it.
RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

COPY frontend/package.json frontend/package-lock.json* ./
# `npm ci` when there is a lockfile: it installs exactly what was resolved,
# which is the difference between a reproducible image and one that quietly
# picks up a new minor of a transitive dependency on rebuild.
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi

COPY frontend/ ./

# Baked at build time, not read at runtime: Vite inlines VITE_* into the
# bundle, so this cannot be an env var on the running container. An image is
# therefore environment-specific — which is why the default is a same-origin
# relative path, letting one image work anywhere the API is behind /api on the
# same host.
ARG VITE_API_BASE_URL=""
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

RUN npm run build

# ── Stage 2: serve ───────────────────────────────────────────────────────────
FROM nginx:1.27-alpine AS runtime

COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /build/dist /usr/share/nginx/html

EXPOSE 80

# wget is in the alpine base; no extra package for a healthcheck that only has
# to prove nginx is answering.
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://127.0.0.1/ || exit 1
